{
  "name": "奇想组合 · 形状 × 材质",
  "captions": [
    [
      0.2,
      "风火轮：火做的环掺着风，跟着施法者冲过去，撞上就炸"
    ],
    [
      2.6,
      "冰火双螺旋：同一条路，冰永远走直线，火绕着它转"
    ],
    [
      4.2,
      "雷冰法阵：法阵不画在身后，画在敌人身上，阵成即爆"
    ],
    [
      6.2,
      "千丝缝合：十六根沙丝从四面八方同时扎进目标"
    ],
    [
      8.0,
      "多米诺：两组火球交错挂成一排，一道雷点燃第一颗，一颗接一颗炸过去"
    ],
    [
      11.0,
      "雷沙龙卷：龙卷不一定是风——用雷做，再掺一缕沙"
    ],
    [
      14.0,
      "冰柱进军：冰做的地柱，从脚下一根接一根顶到目标"
    ],
    [
      16.0,
      "元素牢笼：五种元素拧成的环把目标关住，收紧三次后一起炸开"
    ],
    [
      19.0,
      "冰雷天降：冰做的光束缠着雷，从天上一根根砸下来"
    ]
